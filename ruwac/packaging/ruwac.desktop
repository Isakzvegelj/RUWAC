[Desktop Entry]
Type=Application
Name=RUWAC
Comment=Persistent terminals, remote desktops and files
Exec=/usr/bin/ruwac gui
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;RemoteAccess;
StartupNotify=true
Actions=NewWindow;Update;

[Desktop Action NewWindow]
Name=New window
Exec=/usr/bin/ruwac gui --new-instance

[Desktop Action Update]
Name=Install verified update
Exec=/usr/bin/ruwac update --install
